<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.QuranFragment"
    android:background="@drawable/main"
    android:padding="16dp"
    >
    <ImageView
        android:id="@+id/islami_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/islami_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="45dp"
        app:layout_constraintTop_toTopOf="parent"
        />
    <TextView
        android:id="@+id/suras_list_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/suras_list"
        android:textColor="@color/white"
        android:layout_marginTop="130dp"
        app:layout_constraintTop_toBottomOf="@id/islami_logo"
        />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/quran_recycle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="160dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_quran"
        />

    <!-- TODO: Update blank fragment layout -->


</FrameLayout>